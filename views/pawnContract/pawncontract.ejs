          border: 1px solid #ccc;
          border-radius: 4px;
          width: 300px; /* Thay đổi kích thước ô tìm kiếm */
      }
      table {
          width: 100%;
          border-collapse: collapse;
          margin: 20px 0;
          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }
      th, td {
          padding: 12px;
          text-align: left;
          border: 1px solid #ddd;
      }
      th {
          background-color: #f2f2f2;
      }
      tr:hover {
          background-color: #f1f1f1;
      }
      .back-button, .create-button, .action-button {
          display: block;
          margin: 20px auto;
          padding: 10px 15px;
          color: white;
          text-decoration: none;
          border-radius: 5px;
          text-align: center;
          width: 150px;
          transition: background-color 0.3s;
      }
      .back-button {
          background-color: #007bff;
      }
      .create-button {
          background-color: #28a745;
      }
      .action-button {
          background-color: #007bff;
          margin: 0 5px;
          border: none;
          cursor: pointer;
      }
      .back-button:hover {
          background-color: #0056b3;
      }
      .create-button:hover {
          background-color: #218838;
      }
      .action-button:hover {
          background-color: #0056b3;
      }
  </style>
</head>
<body>
  <h1>Xem Hợp Đồng Cầm Đồ</h1>
  
  <!-- Bộ lọc tìm kiếm và trạng thái -->
  <div class="filter-container">
      <div>
          <label for="searchInput">Tìm Kiếm:</label>
          <input type="text" id="searchInput" placeholder="Nhập tên khách hàng hoặc tài sản..." onkeyup="searchContracts()">
      </div>
      <div>
          <label for="statusFilter">Chọn Trạng Thái:</label>
          <select id="statusFilter" onchange="searchContracts()">
              <option value="">Tất cả</option>
              <option value="active">Đang Hoạt Động</option>
              <option value="near_due">Sắp Đến Hạn</option>
              <option value="overdue">Quá Hạn</option>
              <option value="liquidated">Đã Thanh Lý</option>
              <option value="closed">Đã Đóng</option>
          </select>
      </div>
  </div>

  <table>
      <thead>
          <tr>
              <th>Tên Khách Hàng</th>
              <th>Tên Tài Sản</th>
              <th>Số Tiền Cầm</th>
              <th>Ngày Bắt Đầu</th>
              <th>Ngày Kết Thúc</th>
              <th>Tổng Số Tiền Phải Trả</th>
              <th>Trạng Thái</th>
              <th>Hành Động</th>
          </tr>
      </thead>
      <tbody id="contractTable">
          <% if (contracts && contracts.length > 0) { %>
              <% contracts.forEach(contract => { %>
                  <tr>
                      <td><%= contract.customerName %></td>
                      <td><%= contract.assetName %></td>
                      <td><%= contract.principalAmount.toLocaleString('vi-VN') %> VND</td>
                      <td><%= new Date(contract.startDate).toLocaleDateString('vi-VN') %></td>
                      <td><%= new Date(contract.endDate).toLocaleDateString('vi-VN') %></td>
                      <td><%= contract.totalAmountDue.toLocaleString('vi-VN') %> VND</td>
                      <td><%= contract.status.charAt(0).toUpperCase() + contract.status.slice(1) %></td>
                      <td>
                          <a href="/api/v1/pawnContract/update-pawn-contract/<%= contract._id %>" class="action-button">Cập Nhật</a>
                          <a href="/api/v1/pawnContract/get-pawn-contract-by-id/<%= contract._id %>" class="action-button">Chi Tiết</a>
                          <form action="/api/v1/pawnContract/delete-pawn-contract/<%= contract._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hợp đồng này không?');" style="display:inline;">
                              <button type="submit" class="action-button">Xóa</button>
                          </form>
                      </td>
                  </tr>
              <% }); %>
          <% } else { %>
              <tr>
                  <td colspan="8" style="text-align: center;">Không có hợp đồng nào.</td>
              </tr>
          <% } %>
      </tbody>
  </table>
  <a href="/api/v1/pawnContract/create-pawn-contract" class="create-button" id="createContractBtn">Tạo Hợp Đồng Mới</a>
</body>

  <script>
      function searchContracts() {
          const input = document.getElementById('searchInput').value.toLowerCase();
          const selectedStatus = document.getElementById('statusFilter').value.toLowerCase();
          const table = document.getElementById('contractTable');
          const rows = table.getElementsByTagName('tr');

          // Duyệt qua tất cả các hàng trong bảng
          for (let i = 0; i < rows.length; i++) {
              const cells = rows[i].getElementsByTagName('td');
              if (cells.length > 0) {
                  const customerName = cells[0].textContent.toLowerCase();
                  const assetName = cells[1].textContent.toLowerCase();
                  const status = cells[6].textContent.toLowerCase();

                  // Kiểm tra xem ô tìm kiếm và trạng thái có khớp với hàng hiện tại không
                  const matchesSearch = customerName.includes(input) || assetName.includes(input);
                  const matchesStatus = selectedStatus === '' || status.includes(selectedStatus);

                  // Hiển thị hàng nếu cả hai điều kiện đều thỏa mãn
                  if (matchesSearch && matchesStatus) {
                      rows[i].style.display = ''; // Hiển thị hàng
                  } else {
                      rows[i].style.display = 'none'; // Ẩn hàng
                  }
              }
          }
      }
  </script>
</body>



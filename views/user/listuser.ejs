          <div class="filter-container">
            <label for="searchInput">Tìm Kiếm:</label>
            <input type="text" id="searchInput" placeholder="Nhập tên khách hàng hoặc tài sản..." onkeyup="searchLiquidationContracts()">
        </div>
            <h1>Danh sách Người Dùng</h1>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Hình Ảnh</th>
                        <th>Tên người dùng</th>
                        <th>Email</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach((user) => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td>
                                <img src="/views/images/hinhnen.jpg" alt="<%= user.name %>'s Image" style="width: 50px; height: 50px; border-radius: 50%;">
                            </td>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td class="action-buttons">
                                
                            </td>
                            
                        </tr>
                    <% }) %>
                    <!-- <div class="action-buttons">
                        <button class="add-user-button" onclick="addUser()"><i class="fas fa-plus"></i> Thêm Người Dùng</button>
                    </div -->
                </tbody>
            </table>
            <script>
              function searchLiquidationContracts() {
                  // Lấy giá trị tìm kiếm từ ô input
                  const input = document.getElementById('searchInput');
                  const filter = input.value.toLowerCase(); // Chuyển đổi thành chữ thường để so sánh
                  const table = document.querySelector('table'); // Lấy bảng
                  const rows = table.getElementsByTagName('tr'); // Lấy tất cả các hàng trong bảng
          
                  // Lặp qua tất cả các hàng trong bảng, trừ hàng đầu tiên (tiêu đề)
                  for (let i = 1; i < rows.length; i++) {
                      const cells = rows[i].getElementsByTagName('td');
                      let found = false;
          
                      // Kiểm tra các ô trong hàng
                      for (let j = 0; j < cells.length; j++) {
                          const cell = cells[j];
                          if (cell) {
                              // Kiểm tra nếu ô chứa giá trị tìm kiếm
                              if (cell.textContent.toLowerCase().indexOf(filter) > -1) {
                                  found = true; // Nếu tìm thấy, đánh dấu là có
                                  break; // Thoát vòng lặp
                              }
                          }
                      }
          
                      // Hiển thị hoặc ẩn hàng dựa trên kết quả tìm kiếm
                      if (found) {
                          rows[i].style.display = ''; // Hiển thị hàng
                      } else {
                          rows[i].style.display = 'none'; // Ẩn hàng
                      }
                  }
              }
          </script>
            <div class="pagination">
                <p>Trang <%= currentPage %> / <%= totalPages %></p>
             
            </div>

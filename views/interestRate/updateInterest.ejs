<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cập nhật Lãi suất</title>
    <link rel="stylesheet" href="/styles.css"> <!-- Đường dẫn đến file CSS nếu có -->
    <style>
        /* Tổng thể */
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        h1 {
            text-align: center;
            color: #333;
            font-size: 24px;
            margin-bottom: 20px;
        }

        /* Biểu mẫu */
        form {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 5px;
            font-weight: bold;
        }

        input[type="text"], input[type="number"] {
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 10px;
            font-size: 16px;
            color: #fff;
            background-color: #4CAF50;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #45a049;
        }

        /* Nút Quay Lại */
        .back-button {
            background-color: #555;
            margin: 10px 0;
            text-align: center;
            display: inline-block;
            padding: 10px 15px;
            color: #fff;
            text-decoration: none;
        }

        .back-button:hover {
            background-color: #444;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Cập nhật Lãi suất</h1>
        
        <form id="updateInterestRateForm" action="/api/v1/interestRate/update-interest-rate/<%= rate._id %>?_method=PATCH"" method="POST">
            <label for="assetType">Loại Tài Sản</label>
            <input type="text" id="assetType" name="assetType" value="<%= rate.assetType %>" required>
        
            <label for="rate">Lãi Suất (%/ngày)</label>
            <input type="number" id="rate" name="rate" value="<%= rate.rate %>" required>
        
            <button type="submit">Cập nhật</button>
        </form>
        

        <a href="/api/v1/InterestRate/get-interest-rate" class="back-button">Quay Lại</a>
    </div>
    <script>
        document.getElementById("updateInterestRateForm").addEventListener("submit", async function (event) {
            event.preventDefault(); // Ngăn chặn hành vi gửi form mặc định
    
            const form = event.target;
            const formData = new FormData(form);
    
            // Chuyển đổi FormData thành JSON
            const data = Object.fromEntries(formData.entries());
    
            try {
                const response = await fetch(form.action, {
                    method: "PATCH",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(data)
                });
    
                if (response.ok) {
                    // Hiển thị thông báo và chuyển hướng sau khi cập nhật lãi suất thành công
                    alert("Cập nhật lãi suất thành công!");
                    window.location.href = "http://localhost:9090/api/v1/InterestRate/get-interest-rate";
                } else {
                    const error = await response.json();
                    alert(`Cập nhật lãi suất thất bại: ${error.message || "Lỗi không xác định"}`);
                }
            } catch (error) {
                alert(`Lỗi khi gửi yêu cầu: ${error.message}`);
            }
        });
    </script>
</body>
</html>
